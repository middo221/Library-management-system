# Copy to .env and adjust. Never commit the real .env.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DB_ENGINE empty for local SQLite; docker compose sets these to Postgres.
DB_ENGINE=
DB_NAME=library
DB_USER=library
DB_PASSWORD=library
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Circulation policy
MAX_ACTIVE_LOANS=5
LOAN_PERIOD_DAYS=14
MAX_RENEWALS=2
OVERDUE_FINE_PER_DAY=0.50
DEFAULT_REPLACEMENT_COST=30.00
HOLD_SHELF_DAYS=3
UNPAID_FINE_BLOCK_THRESHOLD=10.00

LOG_LEVEL=INFO
